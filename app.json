{
    "expo": {
        "name": "BisBetania",
        "slug": "bisbetania",
        "version": "1.0.0",
        "orientation": "portrait",
        "scheme": "betania",
        "userInterfaceStyle": "light",
        "icon": "./assets/images/icon.png",
        "splash": {
            "image": "./assets/images/church.png",
            "resizeMode": "cover",
            "backgroundColor": "#1A472A"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/icon.png",
                "backgroundColor": "#1A472A"
            },
            "package": "com.bisbetania",
            "softwareKeyboardLayoutMode": "pan"
        },
        "plugins": [
            "expo-router", [
                "expo-web-browser",
                {}
            ]
        ],
        "experiments": {
            "typedRoutes": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "a6e103a7-7dd9-4f7d-b589-98a7a7c95807"
            }
        },
        "owner": "bisbetania"
    }
}